PORT=4000
# Prefer DB_STRING (used by this app). DATABASE_URL also works.
# Put the real connection string in backend/.env — never commit secrets here.
DB_STRING=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=
DB_SSL=false
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=01_WERMS
DB_USER=postgres
DB_PASSWORD=your_password_here

# Signup notifications (SuperAdmin inbox via Cloudflare Email Routing)
SUPERADMIN_NOTIFY_EMAIL=signup@softchariot.com
EMAIL_FROM=noreply@softchariot.com
# MasterOrganization.OrganizationId for individual self-signup (default 3)
SIGNUP_INDIVIDUAL_ORG_ID=3
# MasterDesignation.DesignationId for individual self-signup (default 4)
SIGNUP_INDIVIDUAL_DESIGNATION_ID=4

# Required for actual outbound email (otherwise signup still saves, email is only logged)
# RESEND_API_KEY=re_xxxxxxxx
